<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light-only base so the university palette looks the same on every device -->
    <style name="Base.Theme.UniversityNavigator" parent="Theme.Material3.Light.NoActionBar" />

    <style name="Theme.UniversityNavigator" parent="Base.Theme.UniversityNavigator">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_light</item>
        <item name="colorOnSecondaryContainer">@color/on_accent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
    </style>

    <!-- Text styles -->
    <style name="TextStyle.UniversityNavigator.ScreenTitle" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextStyle.UniversityNavigator.Subtitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextStyle.UniversityNavigator.SectionLabel" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="TextStyle.UniversityNavigator.DetailLabel" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextStyle.UniversityNavigator.DetailValue" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
    </style>

    <style name="TextStyle.UniversityNavigator.ProfessorValue" parent="TextStyle.UniversityNavigator.DetailValue">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.UniversityNavigator.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
    </style>

    <style name="Widget.UniversityNavigator.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="strokeColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
    </style>

    <style name="Widget.UniversityNavigator.BackButton" parent="Widget.UniversityNavigator.SecondaryButton">
        <item name="icon">@drawable/ic_arrow_back</item>
    </style>

    <style name="Widget.UniversityNavigator.AccentButton" parent="Widget.UniversityNavigator.PrimaryButton">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="iconTint">@color/on_accent</item>
    </style>

    <!-- Card-style selectable option used for universities and departments -->
    <style name="Widget.UniversityNavigator.OptionRadio" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_marginBottom">@dimen/space_m</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_option</item>
        <item name="android:drawableEnd">@drawable/ic_option_indicator</item>
        <item name="android:drawablePadding">@dimen/space_m</item>
        <item name="android:minHeight">@dimen/option_min_height</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
