<?xml version="1.0" encoding="utf-8"?>

<!-- Root padding is set at runtime from the system-bar insets, so spacing lives on the inner layout -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_vertical"
        android:paddingBottom="@dimen/screen_padding_vertical">

        <ImageView
            android:layout_width="@dimen/header_icon_size"
            android:layout_height="@dimen/header_icon_size"
            android:background="@drawable/bg_circle_primary"
            android:padding="@dimen/header_icon_padding"
            android:src="@drawable/ic_school"
            android:importantForAccessibility="no"
            app:tint="@color/white" />

        <TextView
            style="@style/TextStyle.UniversityNavigator.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:text="@string/main_title"
            android:textSize="30sp"
            android:accessibilityHeading="true"
            tools:targetApi="28" />

        <View
            android:layout_width="@dimen/accent_bar_width"
            android:layout_height="@dimen/accent_bar_height"
            android:layout_marginTop="@dimen/space_m"
            android:background="@color/accent" />

        <TextView
            style="@style/TextStyle.UniversityNavigator.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center"
            android:text="@string/main_subtitle" />

        <Button
            android:id="@+id/searchUniversityButton"
            style="@style/Widget.UniversityNavigator.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/search_university"
            app:icon="@drawable/ic_school" />

        <Button
            android:id="@+id/exitButton"
            style="@style/Widget.UniversityNavigator.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/exit" />

    </LinearLayout>

</ScrollView>
