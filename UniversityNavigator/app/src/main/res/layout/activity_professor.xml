<?xml version="1.0" encoding="utf-8"?>

<!-- Root padding is set at runtime from the system-bar insets, so spacing lives on the inner layouts -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                style="@style/TextStyle.UniversityNavigator.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_3" />

            <TextView
                style="@style/TextStyle.UniversityNavigator.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/professor_title"
                android:accessibilityHeading="true"
                tools:targetApi="28" />

            <TextView
                style="@style/TextStyle.UniversityNavigator.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/professor_hint" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextStyle.UniversityNavigator.DetailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_university" />

                    <TextView
                        android:id="@+id/universityText"
                        style="@style/TextStyle.UniversityNavigator.DetailValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="University of Guelph" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginTop="@dimen/space_l"
                        android:layout_marginBottom="@dimen/space_l"
                        android:background="@color/divider" />

                    <TextView
                        style="@style/TextStyle.UniversityNavigator.DetailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_department" />

                    <TextView
                        android:id="@+id/departmentText"
                        style="@style/TextStyle.UniversityNavigator.DetailValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="School of Engineering" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginTop="@dimen/space_l"
                        android:layout_marginBottom="@dimen/space_l"
                        android:background="@color/divider" />

                    <TextView
                        style="@style/TextStyle.UniversityNavigator.DetailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_professor" />

                    <TextView
                        android:id="@+id/professorText"
                        style="@style/TextStyle.UniversityNavigator.ProfessorValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Dr. Petros Spachos" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextStyle.UniversityNavigator.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/actions_title" />

            <Button
                android:id="@+id/mapsButton"
                style="@style/Widget.UniversityNavigator.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/view_on_maps"
                app:icon="@drawable/ic_map_pin" />

            <Button
                android:id="@+id/websiteButton"
                style="@style/Widget.UniversityNavigator.AccentButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/view_professor_website"
                app:icon="@drawable/ic_web" />

        </LinearLayout>

    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_l"
        android:paddingBottom="@dimen/space_l">

        <Button
            android:id="@+id/backButton"
            style="@style/Widget.UniversityNavigator.BackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back" />

    </LinearLayout>

</LinearLayout>
